# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
# anchored to root (the Python build output) so the committed frontend/dist is kept
/dist/
.venv/
venv/
env/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Data / model artifacts (kept out of git; generated locally).
# Anchored to the repo root so the source package src/slipguard/data/ stays tracked;
# the demo fixture used by the quickstart is kept so a fresh clone can run `score`.
/data/*
!/data/demo.json
/artifacts/
/datasets/
# generated tampered receipts (regenerate with `slipguard make-fakes`; -f to commit a subset)
/fakes/
*.ckpt
*.pt
*.onnx

# Secrets — never commit API keys / credentials. Real values live in a local
# .env (or the shell env); commit only .env.example with placeholder keys.
.env
.env.*
!.env.example

# Frontend (web UI) — ignore the Node toolchain only. The React source (frontend/src) AND the built
# frontend/dist are tracked, so a fresh `git clone` serves the UI with no Node/npm install needed.
node_modules/
frontend/node_modules/

# OS / editor
.DS_Store
.idea/
.vscode/
