# Copy this to `.env` (which is gitignored) and fill in real keys.
# The CLI and web UI read these from `.env` or the shell environment.
# At least one provider key is needed — the local LM Studio provider needs none.

# --- Groq (hosted, OpenAI-compatible) ---
# Add numbered fallbacks; they are used automatically when an earlier key hits its rate/daily limit.
GROQ_API_KEY=gsk_xxx
GROQ_API_KEY_2=gsk_xxx          # optional fallback (then GROQ_API_KEY_3, _4, ...)

# --- Google Gemini (hosted; accepts PDFs natively) ---
GEMINI_API_KEY=xxx
# GOOGLE_API_KEY=xxx            # alternative env name Gemini also accepts

# --- Local LM Studio (no key; OpenAI-compatible server) ---
# Only set these to override the defaults.
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=google/gemma-4-e4b
